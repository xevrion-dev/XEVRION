-- button shows: BOOST (ready) / BOOST ▲ (active) / BOOST 3s (cooldown)
function FX.updateBoostUI(now)
	local btn = FX.boostButton

	if not btn then
		return
	end

	local text, color, bg

	if now < FX.boostUntil then
		text = FX.L("boost") .. " ▲"
		color = THEME.Danger
		bg = 0.05
	elseif now < FX.boostReadyAt then
		text = FX.L("boost") .. " " .. math.ceil(FX.boostReadyAt - now) .. "s"
		color = THEME.Muted
		bg = 0.5
	else
		text = FX.L("boost")
		color = THEME.Warn
		bg = 0.25
	end

	if text ~= FX.boostText then
		FX.boostText = text
		btn.Text = text
		btn.TextColor3 = color
		FX.boostStroke.Color = color
		btn.BackgroundTransparency = bg
	end
end

