-- every row is assigned to a tab by its LayoutOrder:  1-21 and 99 = DRONE,  22-39 = SWARM,  40-98 = ORBIT
FX.tab = 1
FX.tabButtons = {}

function FX.tabOf(order)
	if order == 0 then
		return 0
	end

	if order <= 21 or order == 99 then
		return 1
	end

	if order <= 39 then
		return 2
	end

	if order <= 59 then
		return 3
	end

	if order <= 79 then
		return 4
	end

	return 5
end

function FX.applyTab()
	for _, child in ipairs(body:GetChildren()) do
		if child:IsA("GuiObject") then
			local t = FX.tabOf(child.LayoutOrder)

			child.Visible = (t == 0) or (t == FX.tab)
		end
	end

	for i, b in ipairs(FX.tabButtons) do
		if i == FX.tab then
			applyButtonStyle(b, THEME.OnBase, THEME.Accent, 0.3)
		else
			applyButtonStyle(b, THEME.Panel, THEME.Cyan, 0.75)
		end
	end

	body.CanvasPosition = Vector2.new(0, 0)
end

function FX.setTab(i)
	FX.tab = i
	FX.applyTab()

	SW.wantMode = (i == 3 and "orbit") or (i == 4 and "tornado") or (i == 5 and "scatter") or "swarm"

	if SW.syncMode then
		SW.syncMode()
	end

	if i >= 3 and SW.buildList then
		SW.buildList()
	end
end

