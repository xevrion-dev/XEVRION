function stopDrone()
	local wasActive = droneActive

	droneActive = false
	bombFlying = false

	forward = false
	backward = false
	left = false
	right = false

	clearPhysics()

	selectedBomb = nil
	cameraTouch = nil
	camReady = false

	setLock(false)

	FX.boostUntil = 0
	FX.boostReadyAt = 0
	FX.boostText = ""
	FX.hitT = nil
	FX.autoAtk = false
	FX.lastBombPos = nil

	if rightMouseDown then
		rightMouseDown = false
		UIS.MouseBehavior = Enum.MouseBehavior.Default
	end

	hud.Visible = false
	lockGui.Enabled = false
	InfoCard.hide()

	-- v15: reset speed fx + camera look-at smoothing + FOV
	FX.speedK = 0
	FX.aim = nil
	FX.linesOn = false
	FX.fxGui.Enabled = false

	if wasActive then
		Camera.FieldOfView = FX.origFov
	end

	if droneSound.IsPlaying then
		droneSound:Stop()
	end

	Camera.CameraType = Enum.CameraType.Custom

	toggle.Visible = true

	refreshDroneButton()
	resetBombButton()
	setStatus(false)

	lastPosition = nil
	flightStart = 0
	maxAltitude = 0

	if wasActive then
		playUI("Off")
	end
end

--========================================================
-- START
--========================================================

function startDrone()
	if editMode then
		return
	end

	if not selectedBomb then
		selectedBomb = getBombTarget()

		if not selectedBomb then
			droneButton.Text = FX.L("btn_drone_nobomb")
			applyButtonStyle(droneButton, THEME.ErrorBase, THEME.Danger, 0.3)
			playUI("Error")

			task.delay(1, function()
				if not droneActive then
					refreshDroneButton()
				end
			end)

			return
		end
	end

	readCameraAngles()
	setupPhysics(selectedBomb)

	droneActive = true
	bombFlying = true
	camReady = false

	flightStart = os.clock()
	lastPosition = selectedBomb.Position
	maxAltitude = selectedBomb.Position.Y
	lastUpdate = os.clock()
	nextRadarScan = 0

	FX.origFov = Camera.FieldOfView
	FX.speedK = 0
	FX.aim = nil

	Camera.CameraType = Enum.CameraType.Scriptable

	setMenuOpen(false, true)
	toggle.Visible = false

	refreshDroneButton()
	setStatus(true)
	refreshLockUI()
	playUI("On")

	updateDroneUI()
	updateSpeedUI()
	showMessage(FX.L("m_link"), HUD_GREEN)
end

