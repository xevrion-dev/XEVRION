local function createMoveButton(text, pos)
	local b = Instance.new("TextButton")

	b.Size = UDim2.fromOffset(58, 58)
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.Position = pos
	b.BackgroundColor3 = HUD_DARK
	b.BackgroundTransparency = 0.2
	b.BorderSizePixel = 0
	b.Text = text
	b.TextColor3 = HUD_GREEN
	b.TextSize = 25
	b.Font = Enum.Font.GothamBold
	b.AutoButtonColor = false
	b.Parent = controls

	addCorner(b, 14)

	local s = addStroke(b, HUD_GREEN, 1.5, 0.5)

	local sc = Instance.new("UIScale")
	sc.Parent = b

	local function pressed()
		tween(sc, 0.08, { Scale = 0.9 })
		tween(b, 0.08, { BackgroundColor3 = Color3.fromRGB(30, 90, 50) })
		tween(s, 0.08, { Transparency = 0.1 })
	end

	local function released()
		tween(sc, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
		tween(b, 0.2, { BackgroundColor3 = HUD_DARK })
		tween(s, 0.2, { Transparency = 0.5 })
	end

	b.InputBegan:Connect(function(input)
		if isPress(input) then
			pressed()
		end
	end)

	b.InputEnded:Connect(function(input)
		if isPress(input) then
			released()
		end
	end)

