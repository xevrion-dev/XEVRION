--========================================================
-- CAMERA LOOK (swipe / right mouse)
--========================================================

local function isControlUI(object)
	return object == toggle
		or object == menu
		or object:IsDescendantOf(menu)
		or object:IsDescendantOf(toggle)
		or object:IsDescendantOf(controls)
		or object:IsDescendantOf(radar)
		or object:IsDescendantOf(bottomGroup)
		or object:IsDescendantOf(editLayer)
		or object:IsA("GuiButton")
end

local function applyLook(dx, dy, sensitivity)
	if lockEnabled then
		setLock(false, FX.L("m_lockbroken"))
	end

	sensitivity = sensitivity * (Cfg.sens / 100)

	targetYaw -= dx * sensitivity
	targetPitch = math.clamp(targetPitch - dy * sensitivity, -MAX_PITCH, MAX_PITCH)
end

UIS.InputBegan:Connect(function(input, gp)
	if not droneActive or editMode then
		return
	end

	if input.UserInputType == Enum.UserInputType.Touch then
		if gp or cameraTouch then
			return
		end

		local pos = input.Position
		local objects = gui:GetGuiObjectsAtPosition(pos.X, pos.Y)

		for _, object in ipairs(objects) do
			if isControlUI(object) then
				return
			end
		end

		cameraTouch = input

	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		if gp then
			return
		end

		rightMouseDown = true
		UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
	end
end)

UIS.InputChanged:Connect(function(input)
	if not droneActive or editMode then
		return
	end

	if input.UserInputType == Enum.UserInputType.Touch then
		if input == cameraTouch then
			applyLook(input.Delta.X, input.Delta.Y, CAMERA_SENSITIVITY)
		end

	elseif input.UserInputType == Enum.UserInputType.MouseMovement then
		if rightMouseDown then
			applyLook(input.Delta.X, input.Delta.Y, MOUSE_SENSITIVITY)
		end
	end
end)

UIS.InputEnded:Connect(function(input)
	if input == cameraTouch then
		cameraTouch = nil
	end

	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		if rightMouseDown then
			rightMouseDown = false
			UIS.MouseBehavior = Enum.MouseBehavior.Default
		end
	end
end)

--========================================================
-- KEYBOARD
--========================================================

UIS.InputBegan:Connect(function(input, gp)
	if gp then
		return
	end

	local key = input.KeyCode

	if key == Enum.KeyCode.F then
		if droneActive then
			stopDrone()
		else
			startDrone()
		end

	elseif key == Enum.KeyCode.L then
		if droneActive then
			setLock(not lockEnabled)
		end

	elseif key == Enum.KeyCode.T then
		if droneActive then
			FX.cycleTarget()
		end

	elseif key == Enum.KeyCode.B then
		if droneActive then
			FX.doBoost()
		end

	elseif key == Enum.KeyCode.R then
		if droneActive then
			FX.cycleRadar()
		end

	elseif key == Enum.KeyCode.W then
		forward = true

	elseif key == Enum.KeyCode.S then
		backward = true

	elseif key == Enum.KeyCode.A then
		left = true

	elseif key == Enum.KeyCode.D then
		right = true

	elseif key == Enum.KeyCode.Q then
		changeSpeed(-SPEED_STEP)

	elseif key == Enum.KeyCode.E then
		changeSpeed(SPEED_STEP)
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.W then
		forward = false
	elseif input.KeyCode == Enum.KeyCode.S then
		backward = false
	elseif input.KeyCode == Enum.KeyCode.A then
		left = false
	elseif input.KeyCode == Enum.KeyCode.D then
		right = false
	end
end)

--========================================================
-- MAIN FLIGHT LOOP
--========================================================

RunService.RenderStepped:Connect(function()
	if not droneActive or not bombFlying or not selectedBomb then
		hud.Visible = editMode
		lockGui.Enabled = false
		return
	end

	-- bomb was destroyed (it exploded): NO SIGNAL glitch, then back to the player
	if not selectedBomb.Parent then
		if FX.lastBombPos then
			-- v23: the bomb is gone = it exploded, visual blast where it disappeared
			local ex = Instance.new("Explosion")

			ex.Position = FX.lastBombPos
			ex.BlastRadius = 12
			ex.BlastPressure = 0
			ex.DestroyJointRadiusPercent = 0
			ex.ExplosionType = Enum.ExplosionType.NoCraters
			ex.Parent = workspace

			playUI("Error")
		end

		FX.noSignal()
		stopDrone()
		return
	end

	FX.lastBombPos = selectedBomb.Position

	updateDroneUI()

	local now = os.clock()
	local dt = math.max(now - lastUpdate, 0.001)

	FX.updateBoostUI(now)

	-- radar scan (throttled)
	if now >= nextRadarScan then
		nextRadarScan = now + RADAR_RATE
		scanContacts()
	end

	-- lock validity
	if lockEnabled then
		local model = lockRoot and lockRoot.Parent
		local hum = model and model:FindFirstChildOfClass("Humanoid")

		if not hum or hum.Health <= 0 then
			local t = findLockTarget()

			if t then
				lockRoot = t
			else
				setLock(false, FX.L("m_targetlost"))
			end
		end
	end

	-- lock impact: bomb reached the locked target, detonate
	if lockEnabled and lockRoot and lockRoot.Parent then
		local aimNow = getAimPoint(lockRoot)
		local distToAim = (aimNow - selectedBomb.Position).Magnitude
		local hitDist = IMPACT_DIST

		-- while boosting the bomb moves more studs per frame, so widen the hit zone
		if now < FX.boostUntil then
			hitDist = math.max(IMPACT_DIST, SPEED * (Cfg.boost / 100) * math.min(dt, 0.05) * 1.25)
		end

		-- v23: touching the target is NOT an explosion. The flight only ends when the bomb disappears.
		-- Still there = push a moment, bounce away, hit again (automatic until it explodes).
		if distToAim < hitDist and not FX.hitT then
			local away = selectedBomb.Position - aimNow

			away = away.Magnitude > 0.1 and away.Unit or -getLookVector()

			local side = Vector3.new(-away.Z, 0, away.X)

			side = side.Magnitude > 0.1 and side.Unit or Vector3.new(1, 0, 0)

			FX.hitAway = (away + side * ((math.random() * 2 - 1) * 0.6) + Vector3.new(0, 0.35 + math.random() * 0.3, 0)).Unit
			FX.hitT = now

			showMessage(FX.L("sc_retry"), THEME.Warn)
		end
	end

	-- lock aim: turn the nose toward the target's head every frame
	if lockEnabled and lockRoot then
		local toTarget = getAimPoint(lockRoot) - selectedBomb.Position

		if toTarget.Magnitude > 1 then
			local d = toTarget.Unit
			local desiredYaw = math.atan2(-d.X, -d.Z)
			local desiredPitch = math.asin(math.clamp(d.Y, -1, 1))

			targetYaw = yaw + wrapAngle(desiredYaw - yaw)
			targetPitch = math.clamp(desiredPitch, -MAX_PITCH, MAX_PITCH)
		end
	end

	-- angle smoothing
	local smooth = lockEnabled and LOCK_SMOOTHING or CAMERA_SMOOTHING
	local alpha = 1 - math.exp(-smooth * dt)

	yaw += wrapAngle(targetYaw - yaw) * alpha
	pitch += (targetPitch - pitch) * alpha

	local look = getLookVector()
	local cameraRight = CFrame.lookAt(Vector3.zero, look).RightVector
	local fwdFlat = Vector3.new(look.X, 0, look.Z)

	if fwdFlat.Magnitude < 0.001 then
		fwdFlat = Vector3.new(0, 0, -1)
	else
		fwdFlat = fwdFlat.Unit
	end

	-- flight direction
	local direction = Vector3.zero

	if forward then
		direction += look
	end

	if backward then
		direction -= look
	end

	if left then
		direction -= cameraRight
	end

	if right then
		direction += cameraRight
	end

	if direction.Magnitude > 0 then
		direction = direction.Unit
	end

	-- v19 BOOST: temporary speed multiplier (forward along the camera if no key is held)
	local boosting = now < FX.boostUntil

	if boosting and direction.Magnitude == 0 then
		direction = look
	end

	-- v23: automatic push / bounce / re-hit while the locked target is still alive
	if FX.hitT or FX.autoAtk then
		if lockEnabled and lockRoot and lockRoot.Parent then
			local toAim = getAimPoint(lockRoot) - selectedBomb.Position
			local toDir = toAim.Magnitude > 0.05 and toAim.Unit or look

			if FX.hitT then
				local since = now - FX.hitT

				if since < FX.hitContact then
					direction = toDir * 0.6
				elseif since < FX.hitContact + FX.hitRetreat then
					direction = FX.hitAway * 0.45
				else
					FX.hitT = nil
					FX.autoAtk = true
					direction = toDir
				end
			else
				direction = toDir
			end
		else
			FX.hitT = nil
			FX.autoAtk = false
		end
	end

	-- physics (unchanged, plus the boost multiplier)
	if velocity then
		velocity.VectorVelocity = direction * SPEED * (boosting and (Cfg.boost / 100) or 1)
	end

	if orientation and direction.Magnitude > 0 then
		orientation.CFrame = CFrame.lookAt(Vector3.zero, direction)
	end

	-- camera (smoothed follow)
	local bombPos = selectedBomb.Position

	if not camReady then
		camFocus = bombPos
		camReady = true
	end

	camFocus = camFocus:Lerp(bombPos, 1 - math.exp(-CAMERA_FOLLOW * dt))

	local camPos = camFocus - look * Cfg.camDist + Vector3.new(0, CAMERA_HEIGHT, 0)

	local camLook = camPos + look

	-- while locked, the camera looks at the target; the look-at point is
	-- smoothed so switching targets glides instead of snapping
	if lockEnabled and lockRoot and lockRoot.Parent then
		local goal = getAimPoint(lockRoot)

		if not FX.aim then
			FX.aim = camPos + look * math.max((goal - camPos).Magnitude, 10)
		end

		FX.aim = FX.aim:Lerp(goal, 1 - math.exp(-10 * dt))
		camLook = FX.aim
	else
		FX.aim = nil
	end

	local camCF = CFrame.lookAt(camPos, camLook)

	-- v15 speed fx: camera shake that grows with speed
	local k = FX.speedK

	if k > 0.05 then
		local sx = math.noise(now * 22, 0.1, 0.5) * 0.28 * k
		local sy = math.noise(now * 25, 3.3, 1.7) * 0.28 * k
		local roll = math.noise(now * 18, 7.1, 2.9) * math.rad(1.4) * k

		camCF = camCF * CFrame.new(sx, sy, 0) * CFrame.Angles(0, 0, roll)
	end

	Camera.CameraType = Enum.CameraType.Scriptable
	Camera.CFrame = camCF
	Camera.FieldOfView = Cfg.fov + k * 14 -- FOV kick at high speed

	-- telemetry values
	local altitude = bombPos.Y
	maxAltitude = math.max(maxAltitude, altitude)

	local currentSpeed = 0

	if lastPosition then
		currentSpeed = (bombPos - lastPosition).Magnitude / dt
	end

	lastPosition = bombPos
	lastUpdate = now

	-- v15 speed fx: smooth intensity from the real speed + speed lines
	local targetK = Cfg.speedFx and math.clamp((currentSpeed - 150) / 700, 0, 1) or 0

	FX.speedK += (targetK - FX.speedK) * (1 - math.exp(-5 * dt))
	FX.updateLines(dt)

	local airTime = now - flightStart
	local heading = math.deg(math.atan2(-look.X, -look.Z))

	if heading < 0 then
		heading += 360
	end

	local pitchDegrees = math.deg(pitch)
	local throttle = math.clamp(direction.Magnitude, 0, 1) * 100

	-- per-frame: ladder, reticle
	ladder.Position = UDim2.new(0.5, 0, 0.5, pitchDegrees * PX_PER_DEG)
	updateReticle(bombPos)

	-- per-frame: radar sweep + trail
	sweepAngle = (sweepAngle + dt * SWEEP_SPEED) % 360

	-- the line points right (90° bearing) at rotation 0, so bearing = rotation + 90
	local sweepBearing = (sweepAngle + 90) % 360

	for i = 0, TRAIL_COUNT do
		sweepHolders[i].Rotation = sweepAngle - i * TRAIL_STEP
	end

	-- per-frame: blips light up when the sweep passes, then fade out
	for i = 1, #radarDots do
		local dot = radarDots[i]

		if i <= radarBlipCount then
			local b = radarBlips[i]

			if b.locked then
				dot.Visible = true
				dot.BackgroundTransparency = 0
			else
				-- how long ago the sweep passed this bearing
				local behind = (sweepBearing - b.bearing) % 360
				local age = behind / SWEEP_SPEED

				if age < BLIP_FADE then
					dot.Visible = true
					dot.BackgroundTransparency = age / BLIP_FADE
				else
					dot.Visible = false
				end
			end
		else
			dot.Visible = false
		end
	end

	-- throttled: text, tapes, radar positions
	if now >= nextHudUpdate then
		nextHudUpdate = now + HUD_RATE

		updateHeadingTape(heading)
		updateSpeedTape(SPEED)
		updateAltTape(altitude)

		headingReadout.Text = string.format("HDG %03d°", math.floor(heading))

		local lockDist = nil

		if lockEnabled and lockRoot then
			lockDist = (getAimPoint(lockRoot) - bombPos).Magnitude
		end

		telemetry.Text = string.format(
			"GS   %04d st/s\nMAX  %04d st\nAIR  %05.1f s\nTHR  %03d%%\nPIT  %+03d°\nTGT  %s",
			math.floor(currentSpeed),
			math.floor(maxAltitude),
			airTime,
			math.floor(throttle),
			math.floor(pitchDegrees),
			lockDist and string.format("%04d st", math.floor(lockDist)) or "--- st"
		)

		updateRadar(bombPos, fwdFlat, cameraRight)
	end

	if messageLabel.Text ~= "" and now > messageUntil then
		messageLabel.Text = ""
	end
end)

--========================================================
-- v20 SWARM STRIKE
--  • ADD (menu / panel / V): aim at a bomb, it joins the orbit ABOVE you
--    (up to MAX BOMBS, 6 at most)
--  • LOCK / NEXT: choose the target (the camera stays free, never locked)
--  • LAUNCH (panel / G): the bombs scatter upward in different directions,
--    after SCATTER TIME they all home in on the target by themselves
--  • target dies in flight: bombs switch to the next target,
--    or return to the orbit when nobody is left
--  • LOCK OFF while launched = recall (bombs return to the orbit)
--========================================================

do
	local env = (getgenv and getgenv()) or _G

	-- script run again? stop the previous copy first (connections + bomb physics)
	if type(env.__SwarmStrikeCleanup) == "function" then
		pcall(env.__SwarmStrikeCleanup)
	end

	local conns = {}

	local SCATTER_SPEED = 60     -- studs/s right after LAUNCH (slows down while scattering)
	local STAGGER = 0.12         -- seconds between bombs when they start attacking
	local ORBIT_APPROACH = 170   -- max speed of a bomb flying into / back to the orbit
	local TURN_FAR = 7           -- homing turn rate (far from the target)
	local TURN_NEAR = 16         -- homing turn rate (close to the target)
	local NEAR_DIST = 80
	local HIT_GAP = 0.4          -- v22: pause after a hit before the next bomb dives
	local ATTACK_MAX = 5         -- v22: if a diving bomb needs longer than this, the next one may go too
	local SPIN_MULT = 4          -- v22 orbit target: orbit speed x4 right before the hit
	local WAVES = 3              -- v22: number of wave crests around the ring
	local WAVE_SPEED = 2.5       -- v22: how fast the waves travel (rad/s)
	local ORBIT_TGT_LIFT = 4     -- v22: orbit ring around the target sits this high above its head
	local SPIN_RATE = 100        -- v22: self-spin of a diving bomb (rad/s) = hits much harder
	local CONTACT_WAIT = 0.3     -- v23: after touching the target the bomb keeps pushing this long (it may explode)
	local RETREAT_TIME = 0.4     -- v23: not exploded = it bounces away for this long, then hits again
	local RETREAT_MIN = 100      -- v23: minimum bounce-away speed
	local TN_BOTTOM = 0.35       -- v22 tornado: width at the bottom = this fraction of the top width
	local TN_SQUEEZE = 0.35      -- v22 tornado: the funnel gets this much narrower during the spin-up

	-- target box on screen (own ScreenGui, same coordinates as the lock reticle)
	local fxGui = Instance.new("ScreenGui")
	fxGui.Name = "DroneSwarmFx"
	fxGui.ResetOnSpawn = false
	fxGui.IgnoreGuiInset = true
	fxGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	fxGui.Parent = PlayerGui

	local box = Instance.new("Frame")
	box.Name = "SwarmTarget"
	box.Size = UDim2.fromOffset(64, 64)
	box.AnchorPoint = Vector2.new(0.5, 0.5)
	box.BackgroundTransparency = 1
	box.Visible = false
	box.Parent = fxGui

	addStroke(box, THEME.Danger, 2, 0)

	local boxTag = hudText(box, "", UDim2.fromOffset(180, 14), UDim2.new(0.5, -90, 1, 4), Enum.TextXAlignment.Center)
	boxTag.TextColor3 = THEME.Danger
	boxTag.TextSize = 12

	----------------------------------------------------------
	-- small helpers
	----------------------------------------------------------

	function SW.say(text, color)
		SW.msgLabel.Text = text
		SW.msgLabel.TextColor3 = color or HUD_GREEN
		SW.msgUntil = os.clock() + 2.5
	end

	function SW.playerRoot()
		local ch = LP.Character

		return ch and ch:FindFirstChild("HumanoidRootPart") or nil
	end

	function SW.targetName()
		local model = SW.lockRoot and SW.lockRoot.Parent
		local plr = model and Players:GetPlayerFromCharacter(model)

		return plr and plr.Name or "?"
	end

	function SW.has(part)
		for _, b in ipairs(SW.bombs) do
			if b.part == part then
				return true
			end
		end

		return false
	end

	function SW.orbiters()
		local list = {}

		for _, b in ipairs(SW.bombs) do
			if b.phase == "orbit" then
				table.insert(list, b)
			end
		end

		return list
	end

	-- removes the physics objects and gives the bomb its normal collision back
	function SW.release(b)
		if b.av then
			b.av:Destroy()
			b.av = nil
		end

		if b.lv then
			b.lv:Destroy()
		end

		if b.ao then
			b.ao:Destroy()
		end

		if b.att then
			b.att:Destroy()
		end

		if b.part and b.part.Parent then
			pcall(function()
				b.part.CanCollide = b.cc
			end)
		end
	end

	-- v26: NO SPIN any more. The bomb keeps its orientation lock, nose first along the flight path.
	function SW.startSpin(b)
		if b.av then
			b.av:Destroy()
			b.av = nil
		end

		if b.ao then
			b.ao.Enabled = true
		end
	end

	function SW.stopSpin(b)
		if b.av then
			b.av:Destroy()
			b.av = nil
		end

		if b.ao then
			b.ao.Enabled = true
		end
	end

	-- client-side visual, same as the FPV drone impact
	function SW.explode(pos)
		local ex = Instance.new("Explosion")
		ex.Position = pos
		ex.BlastRadius = 12
		ex.BlastPressure = 0
		ex.DestroyJointRadiusPercent = 0
		ex.ExplosionType = Enum.ExplosionType.NoCraters
		ex.Parent = workspace
	end

	----------------------------------------------------------
	-- UI texts
	----------------------------------------------------------

	-- light refresh (labels only, safe to call many times per second)
	function SW.refreshLive()
		local n = #SW.bombs
		local waiting = #SW.orbiters()
		local flying = n - waiting

		local stateText = flying > 0 and FX.L("sw_launched") or FX.L("sw_orbit")

		SW.titleLabel.Text = FX.L("sw_title") .. " " .. n .. "/" .. Cfg.swarmMax .. " • " .. stateText
		SW.titleLabel.TextColor3 = flying > 0 and THEME.Danger or HUD_GREEN

		local lockColor = SW.lockOn and THEME.Danger or HUD_GREEN

		SW.lockBtn.Text = SW.lockOn and FX.L("lock_on") or FX.L("lock_off")
		SW.lockBtn.TextColor3 = lockColor
		SW.lockStroke.Color = lockColor

		local launchColor = waiting > 0 and THEME.Danger or THEME.Muted

		SW.launchBtn.Text = (SW.mode == "orbit" or SW.mode == "tornado") and FX.L("btn_orbit_attack") or FX.L("sw_launch")
		SW.launchBtn.TextColor3 = launchColor
		SW.launchStroke.Color = launchColor

		if SW.lockOn and SW.lockRoot and SW.lockRoot.Parent then
			local me = SW.playerRoot()
			local d = me and (getAimPoint(SW.lockRoot) - me.Position).Magnitude or 0
			local info = string.format("%s  %d st", SW.targetName(), math.floor(d))

			SW.tgtLabel.Text = FX.L("sw_tgt") .. "  " .. info
			boxTag.Text = info
		elseif SW.mode == "scatter" then
			SW.tgtLabel.Text = FX.L("sw_tgt") .. "  " .. FX.L("sc_random") .. " x" .. #SW.bombs
		else
			SW.tgtLabel.Text = FX.L("sw_tgt") .. "  ---"
		end
	end

	-- full refresh (also the ADD buttons in the menu: tab 2 and tab 3)
	function SW.refresh()
		SW.applyCollapse()

		local n = #SW.bombs
		local full = n >= Cfg.swarmMax

		for _, btn in ipairs({ SW.addButton, SW.addButton2, SW.addButton3, SW.addButton4 }) do
			btn.Text = FX.L("btn_swarm_add") .. " (" .. n .. "/" .. Cfg.swarmMax .. ")"

			applyButtonStyle(
				btn,
				full and THEME.OnBase or THEME.Panel,
				full and THEME.Accent or THEME.Cyan,
				full and 0.3 or 0.75
			)
		end

		if SW.paintList then
			SW.paintList()
		end

		SW.refreshLive()
	end

	local function flashAdd(text)
		for _, btn in ipairs({ SW.addButton, SW.addButton2, SW.addButton3, SW.addButton4 }) do
			btn.Text = text
			applyButtonStyle(btn, THEME.ErrorBase, THEME.Danger, 0.3)
		end

		task.delay(1, function()
			SW.refresh()
		end)
	end

	----------------------------------------------------------
	-- targets (players only, FRIEND CHECK respected)
	----------------------------------------------------------

	-- allowed players, nearest to you first
	function SW.list()
		local list = {}
		local me = SW.playerRoot()
		local origin = me and me.Position or Camera.CFrame.Position

		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LP then
				local model = plr.Character
				local hum = model and model:FindFirstChildOfClass("Humanoid")

				if hum and hum.Health > 0 and FX.allowed(plr) then
					local root = model:FindFirstChild("HumanoidRootPart")
						or hum.RootPart
						or model:FindFirstChild("Torso")
						or model:FindFirstChild("UpperTorso")
						or model:FindFirstChild("Head")

					if root and root:IsA("BasePart") and root.Parent then
						local aim = getAimPoint(root)

						table.insert(list, {
							root = root,
							aim = aim,
							dist = (aim - origin).Magnitude,
						})
					end
				end
			end
		end

		table.sort(list, function(a, b)
			return a.dist < b.dist
		end)

		return list
	end

	-- sends every bomb that is not in the orbit back to the orbit
	function SW.recall()
		local any = false

		for _, b in ipairs(SW.bombs) do
			if b.phase ~= "orbit" then
				SW.stopSpin(b)
				b.phase = "orbit"
				b.part.CanCollide = false
				any = true
			end
		end

		SW.spinUntil = nil

		return any
	end

	function SW.setLock(on, message)
		if on then
			-- v23: SCATTER picks a random target for every bomb by itself
			if SW.mode == "scatter" then
				SW.say(FX.L("sc_nolock"), THEME.Warn)
				playUI("Error")
				return false
			end

			local list = SW.list()

			if #list == 0 then
				SW.say(FX.L("m_notarget"), THEME.Danger)
				playUI("Error")
				return false
			end

			-- nearest target in front of the camera, otherwise simply the nearest
			local pick = list[1]

			for _, e in ipairs(list) do
				if Camera:WorldToViewportPoint(e.aim).Z > 0 then
					pick = e
					break
				end
			end

			SW.lockRoot = pick.root
			SW.lockOn = true

			SW.say(FX.L("m_locked"), THEME.Danger)
			playUI("On")
			SW.refresh()

			return true
		end

		local wasOn = SW.lockOn

		SW.lockOn = false
		SW.lockRoot = nil

		if SW.recall() then
			SW.say(FX.L("sw_recall"), THEME.Warn)
		elseif message then
			SW.say(message, THEME.Warn)
		end

		if wasOn then
			playUI("Off")
		end

		SW.refresh()

		return true
	end

	function SW.cycle()
		if droneActive or editMode or SW.mode == "scatter" then
			return
		end

		if not SW.lockOn then
			SW.setLock(true)
			return
		end

		local list = SW.list()

		if #list < 2 then
			SW.say(FX.L("m_noother"), THEME.Warn)
			playUI("Error")
			return
		end

		local idx = 0

		for i, e in ipairs(list) do
			if e.root == SW.lockRoot then
				idx = i
				break
			end
		end

		SW.lockRoot = list[idx % #list + 1].root

		SW.say(FX.L("m_switched"), THEME.Danger)
		playUI("On")
		SW.refresh()
	end

	----------------------------------------------------------
	-- add / clear / launch
	----------------------------------------------------------

	function SW.add()
		if droneActive or editMode then
			return
		end

		SW.syncMode()

		if #SW.bombs >= Cfg.swarmMax then
			SW.say(FX.L("sw_full"), THEME.Warn)
			flashAdd(FX.L("sw_full"))
			playUI("Error")
			return
		end

		local part = getBombTarget()

		if not part or not part.Parent or part == selectedBomb or SW.has(part) then
			SW.say(FX.L("btn_bomb_none"), THEME.Danger)
			flashAdd(FX.L("btn_bomb_none"))
			playUI("Error")
			return
		end

		local att = Instance.new("Attachment")
		att.Name = "SwarmAtt"
		att.Parent = part

		local lv = Instance.new("LinearVelocity")
		lv.Name = "SwarmLV"
		lv.Attachment0 = att
		lv.MaxForce = math.huge
		lv.VectorVelocity = Vector3.zero
		lv.Parent = part

		local ao = Instance.new("AlignOrientation")
		ao.Name = "SwarmAO"
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
		ao.Attachment0 = att
		ao.MaxTorque = math.huge
		ao.Responsiveness = 200
		ao.CFrame = part.CFrame - part.CFrame.Position
		ao.Parent = part

		table.insert(SW.bombs, {
			part = part,
			att = att,
			lv = lv,
			ao = ao,
			cc = part.CanCollide,
			phase = "orbit",
			dir = Vector3.new(0, 1, 0),
			speed = 0,
			spd = SCATTER_SPEED,
			t0 = 0,
			attackAt = 0,
			atkT0 = 0,
			tr = part.Transparency, -- v23: used to see that the bomb disappeared
			lastPos = part.Position,
			hits = 0,
			cT0 = 0,
			rdir = Vector3.new(0, 1, 0),
			tgt = nil,              -- v23 SCATTER: this bomb's own target
		})

		-- no collision while orbiting / scattering (so it never pushes you)
		part.CanCollide = false

		playUI("On")
		SW.say(FX.L("sw_added"), HUD_GREEN)
		SW.refresh()
	end

	function SW.clear()
		if droneActive or editMode then
			return
		end

		for _, b in ipairs(SW.bombs) do
			SW.release(b)
		end

		table.clear(SW.bombs)

		if SW.mode == "swarm" then
			SW.lockOn = false
			SW.lockRoot = nil
		end

		SW.spinUntil = nil

		playUI("Off")
		SW.say(FX.L("sw_cleared"), THEME.Warn)
		SW.refresh()
	end

	-- SWARM (tab 2): scatter upward, then the bombs dive ONE BY ONE
	function SW.launchSwarm()
		local orbiters = SW.orbiters()

		if #orbiters == 0 then
			SW.say(FX.L("sw_empty"), THEME.Warn)
			playUI("Error")
			return
		end

		-- no target yet: lock the nearest one automatically
		if not (SW.lockOn and SW.lockRoot and SW.lockRoot.Parent) then
			if not SW.setLock(true) then
				return
			end
		end

		local now = os.clock()
		local me = SW.playerRoot()
		local center = me and (me.Position + Vector3.new(0, Cfg.swarmHeight, 0)) or Camera.CFrame.Position
		local n = #orbiters

		-- v26 NEAT SPREAD: sort the bombs by their angle around you, then give every bomb its own slot
		-- on an evenly spaced ring (equal gaps, same height). Slot 1 starts at the angle of the first bomb,
		-- so every bomb just slides straight outward to its slot (no crossing paths).
		for _, b in ipairs(orbiters) do
			local d = b.part.Position - center

			b.sa = math.atan2(d.Z, d.X)
		end

		table.sort(orbiters, function(x, y)
			return x.sa < y.sa
		end)

		local base = orbiters[1].sa
		local ringH = math.max(Cfg.swarmHeight * 0.5, 6)

		for i, b in ipairs(orbiters) do
			local a = base + (i - 1) * (2 * math.pi / n)

			b.sp0 = b.part.Position
			b.sp1 = center + Vector3.new(math.cos(a) * Cfg.swarmSpread, ringH, math.sin(a) * Cfg.swarmSpread)
			b.t0 = now
			b.attackAt = now + Cfg.swarmScatter -- spread is finished here, then the bomb rushes at the target
			b.speed = 0
			b.phase = "scatter"
		end

		SW.gapUntil = 0

		playUI("On")
		SW.say(FX.L("sw_go"), THEME.Danger)
		SW.refresh()
	end

	-- v24: look direction that never flips when the bomb flies straight up / down
	function SW.face(dir)
		local up = math.abs(dir.Y) > 0.97 and Vector3.new(0, 0, 1) or Vector3.new(0, 1, 0)

		return CFrame.lookAt(Vector3.zero, dir, up)
	end

	-- v27: the point on the GROUND right under the target (the bomb must slam into the ground there)
	function SW.groundPoint(root)
		local aim = getAimPoint(root)
		local skip = { root.Parent }

		if LP.Character then
			table.insert(skip, LP.Character)
		end

		for _, o in ipairs(SW.bombs) do
			if o.part then
				table.insert(skip, o.part)
			end
		end

		local params = RaycastParams.new()

		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = skip

		local res = workspace:Raycast(aim, Vector3.new(0, -800, 0), params)
		local y = res and res.Position.Y or (aim.Y - 6)

		return Vector3.new(aim.X, y - 1.5, aim.Z)
	end

	-- v28: every waiting bomb gets its OWN slot above the target, far enough from the others
	-- (14 studs apart) so they never touch and never blow up in the air.
	-- Slot 1 = right above the target, slots 2-7 = ring of 6 around it, next 6 = same ring 14 studs higher...
	function SW.holdSlot(b, aim, vel)
		if not b.hs then
			local used = {}

			for _, o in ipairs(SW.bombs) do
				if o ~= b and o.hs and (o.phase == "climb" or o.phase == "hold") then
					used[o.hs] = true
				end
			end

			local k = 1

			while used[k] do
				k += 1
			end

			b.hs = k
		end

		local SPACE = 14
		local j = b.hs - 2
		local off = Vector3.zero
		local layer = 0

		if j >= 0 then
			layer = math.floor(j / 6)

			local a = (j % 6) * (math.pi / 3)

			off = Vector3.new(math.cos(a) * SPACE, 0, math.sin(a) * SPACE)
		end

		return Vector3.new(
			aim.X + vel.X * 0.4 + off.X,
			aim.Y + Cfg.nHeight + layer * SPACE,
			aim.Z + vel.Z * 0.4 + off.Z
		)
	end

	-- v24: every attack starts with a climb: straight up, over the target, then a straight dive ("n")
	function SW.startClimb(b, now)
		SW.stopSpin(b)

		SW.slotN = (SW.slotN or 0) + 1

		b.slot = SW.slotN
		b.phase = "climb"
		b.stage = 1
		b.cl0 = now
		b.speed = 30 -- v28: starts slow and accelerates smoothly like a rocket
		b.cy0 = b.part.Position.Y
		b.hs = nil
		b.atkT0 = now
		b.part.CanCollide = false
	end

	-- v23: the bomb counts as exploded only when it is gone from the game
	function SW.gone(b)
		local p = b.part

		if not p or not p:IsDescendantOf(workspace) then
			return true
		end

		if (b.phase == "attack" or b.phase == "retreat") and b.tr < 0.9 and p.Transparency >= 0.99 then
			return true
		end

		return false
	end

	function SW.alive(root)
		local model = root and root.Parent
		local hum = model and model:FindFirstChildOfClass("Humanoid")

		return hum ~= nil and hum.Health > 0
	end

	-- v23 SCATTER: random new target for one bomb (a target nobody else is using is preferred)
	function SW.pickFor(b)
		local list = SW.list()
		local free = {}

		for _, e in ipairs(list) do
			local used = false

			for _, o in ipairs(SW.bombs) do
				if o ~= b and o.tgt == e.root and (o.phase == "burst" or o.phase == "climb" or o.phase == "hold" or o.phase == "attack" or o.phase == "retreat") then
					used = true
					break
				end
			end

			if not used then
				table.insert(free, e)
			end
		end

		local pool = #free > 0 and free or list

		if #pool == 0 then
			return nil
		end

		return pool[math.random(#pool)].root
	end

	-- v23 SCATTER: position on the outward spiral (p = 0..1 progress, tt = seconds since launch)
	function SW.burstPos(b, p, tt)
		local e = p * p * (3 - 2 * p)
		local r = b.r0 + (b.R1 - b.r0) * e
		local a = b.a0 + b.sgn * math.rad(Cfg.scSpin) * tt

		return b.center + Vector3.new(math.cos(a) * r, b.dh * e, math.sin(a) * r)
	end

	-- v23 SCATTER (tab 5): spiral outward while spinning, then every bomb dashes at its OWN random player
	function SW.launchScatter()
		SW.syncMode()

		if SW.mode ~= "scatter" or SW.mode ~= SW.wantMode then
			SW.say(FX.L("or_busy"), THEME.Warn)
			playUI("Error")
			return
		end

		local orbiters = SW.orbiters()

		if #orbiters == 0 then
			SW.say(FX.L("sw_empty"), THEME.Warn)
			playUI("Error")
			return
		end

		local list = SW.list()

		if #list == 0 then
			SW.say(FX.L("m_notarget"), THEME.Danger)
			playUI("Error")
			return
		end

		-- shuffle the targets: bomb 1 = target 1, bomb 2 = target 2 ... (random order)
		for i = #list, 2, -1 do
			local j = math.random(i)

			list[i], list[j] = list[j], list[i]
		end

		local now = os.clock()
		local me = SW.playerRoot()
		local center = me and (me.Position + Vector3.new(0, Cfg.swarmHeight, 0)) or Camera.CFrame.Position
		local sgn = (math.random() < 0.5) and 1 or -1

		for i, b in ipairs(orbiters) do
			local d = b.part.Position - center
			local flat = Vector3.new(d.X, 0, d.Z)

			b.tgt = list[(i - 1) % #list + 1].root
			b.center = center
			b.a0 = flat.Magnitude > 0.5 and math.atan2(d.Z, d.X) or (i - 1) * (2 * math.pi / #orbiters)
			b.r0 = math.max(flat.Magnitude, 2)
			b.R1 = Cfg.scDist * (0.8 + math.random() * 0.4)
			b.dh = 8 + (math.random() * 2 - 1) * 12
			b.sgn = sgn
			b.t0 = now
			b.attackAt = now + Cfg.scTime
			b.hits = 0
			b.phase = "burst"
		end

		SW.gapUntil = 0

		playUI("On")
		SW.say(FX.L("sc_go"), THEME.Danger)
		SW.refresh()
	end

	-- ORBIT TARGET (tab 3): spin faster for tgtDelay seconds, then every bomb hits the target
	function SW.attackOrbit()
		SW.syncMode()

		if SW.mode == "swarm" or SW.mode == "scatter" or SW.mode ~= SW.wantMode then
			SW.say(FX.L("or_busy"), THEME.Warn)
			playUI("Error")
			return
		end

		if not (SW.lockOn and SW.lockRoot and SW.lockRoot.Parent) then
			SW.say(FX.L("or_pick"), THEME.Warn)
			playUI("Error")
			return
		end

		if #SW.orbiters() == 0 then
			SW.say(FX.L("sw_empty"), THEME.Warn)
			playUI("Error")
			return
		end

		if SW.spinUntil then
			return
		end

		SW.spinT0 = os.clock()
		SW.spinDur = (SW.mode == "tornado") and Cfg.tnDelay or Cfg.tgtDelay
		SW.spinUntil = SW.spinT0 + SW.spinDur

		playUI("On")
		SW.say(FX.L("or_spin"), THEME.Danger)
		SW.refresh()
	end

	-- ORBIT TARGET (tab 3): pick the target straight from the menu list
	function SW.pickPlayer(plr)
		if droneActive or editMode then
			return
		end

		SW.syncMode()

		if SW.mode == "swarm" or SW.mode == "scatter" or SW.mode ~= SW.wantMode then
			SW.say(FX.L("or_busy"), THEME.Warn)
			playUI("Error")
			return
		end

		local model = plr.Character
		local hum = model and model:FindFirstChildOfClass("Humanoid")
		local root = model and (
			model:FindFirstChild("HumanoidRootPart")
			or model:FindFirstChild("Torso")
			or model:FindFirstChild("UpperTorso")
			or model:FindFirstChild("Head")
		)

		if not hum or hum.Health <= 0 or not root then
			SW.say(FX.L("m_notarget"), THEME.Danger)
			playUI("Error")

			if SW.buildList then
				SW.buildList()
			end

			return
		end

		SW.lockRoot = root
		SW.lockOn = true
		SW.spinUntil = nil

		SW.say(FX.L("or_set"), THEME.Danger)
		playUI("On")
		SW.refresh()
	end

	function SW.launch()
		if droneActive or editMode then
			return
		end

		SW.syncMode()

		if SW.mode == "scatter" then
			SW.launchScatter()
		elseif SW.mode ~= "swarm" then
			SW.attackOrbit()
		else
			SW.launchSwarm()
		end
	end

